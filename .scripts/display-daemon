#!/bin/bash

num_of_monitors=$(hyprctl monitors all | grep -c Monitor)

# Variables not working for some reason.. fix later!
# INT_MONITOR="eDP-1" 
# EXT_MONITOR="HDMI-A-1"

if [[ "$1" == "extend" ]]; then
    echo "[MANUAL: Extend] Enabling extend mode..."
    hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = false, mirror = "" })'
    hyprctl eval 'hl.monitor({ output = "HDMI-A-1", disabled = false })'
    pkill -e shimeji-overlay
    exit 0
fi

if [[ "$1" == "mirror" ]]; then
    echo "[MANUAL: Mirror] Enabling mirror mode..."
    hyprctl eval 'hl.monitor({ output = "HDMI-A-1", disabled = false })'
    hyprctl eval 'hl.monitor({ output = "eDP-1", mirror = "HDMI-A-1", disabled = false })'
    pkill -e shimeji-overlay
    exit 0
fi


