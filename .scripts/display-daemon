# This portion is intended only for startup check whether monitor is connected or not:
if [[ $num_of_monitors -gt 1 ]]; then
    echo "[AUTO: HDMI Connected] External display detected. Disabling eDP..."
    hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = true })'
    shimejictl config set "MASCOT_SCALE" 1.25
else
    echo "[AUTO: HDMI Disconnected] No external display detected. Switching back to eDP..."
    hyprctl eval 'hl.monitor({ output = "eDP-1", disabled = false })'
    shimejictl config set "MASCOT_SCALE" 0.75
fi
