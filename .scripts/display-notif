#!/bin/bash

notify-send -i "display" "Display Management" "You sure abt dis?" \
    --action="extend=Extend" \
    --action="auto=Auto" \
    --action="mirror=Mirror" \
    | while read -r action; do
        case "$action" in
            extend)
                ~/.scripts/display-daemon extend
                ;;
            mirror)
                ~/.scripts/display-daemon mirror 
                ;;
            auto)
                ~/.scripts/display-daemon
                ;;
        esac
    done
