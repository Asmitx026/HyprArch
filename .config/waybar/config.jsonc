[{
    "output":["eDP-1","HDMI-A-1"],
    "layer": "top",
    "position": "top",
    "fixed-center": true,
    "reload_style_on_change": true,
    "include": ["~/.config/waybar/modules.jsonc"],
    "modules-left": [
      "hyprland/window",
      "group/utils"
    ],
    "modules-center": [
      "custom/updates",
      "hyprland/workspaces",
      "custom/notifications"
      
    ],
    "modules-right": [
      "group/tools",
      "network",
      "bluetooth",
      "backlight",
      "pulseaudio",
      "group/power",
      "clock"
    ]
},
