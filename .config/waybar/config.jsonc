{
    "output":["eDP-1","HDMI-A-1"],
    "layer": "top",
    "position": "bottom",
    "fixed-center": true,
    "reload_style_on_change": true,
    "include": ["~/.config/waybar/modules.jsonc"],
    "modules-left": [
      "custom/start",
      "wlr/taskbar"
      // "custom/cpucat"
    ],

    "modules-center": [
