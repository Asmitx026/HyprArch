// ~/.config/fastfetch/config.jsonc
// See https://github.com/fastfetch-cli/fastfetch/wiki/Configuration for more details
// See *.jsonc in https://github.com/fastfetch-cli/fastfetch/tree/dev/presets/examples for more examples
{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        // "type": "kitty-direct",
        "type": "file",
        "source": "~/.config/fastfetch/logos/frieren.txt",
        // "width": 37,
        "height": 10,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 5
        }
    },
	"display": {
		"percent": { "type": 9 }, // colored percent number
		"separator": " "
	},
	"modules": [
        { "type": "title", "key": "" },
		{ "type": "os", "key": "󰌽" },
		{ "type": "kernel", "key": "󱗜" },
		{ "type": "wm", "key": "󰨇" },
		{ "type": "shell", "key": "", "format": "{process-name} ({version} - {pid})" },
		{ "type": "packages", "key": "󰏓", "combined": true },
		{ "type": "cpu", "key": "󰍛", "format": "{name}" },
		{ "type": "memory", "key": "󰘚", "format": "{used} / {total} ({percentage})" },
		{ "type": "btrfs", "key": "", "format": "{name}: {used} / {total} ({used-percentage})" },
		{ "type": "battery", "key": "󰂄", "format": "{capacity} ({manufacturer} - {status})" },
		{ "type": "colors", "symbol": "circle" }
	]
}
